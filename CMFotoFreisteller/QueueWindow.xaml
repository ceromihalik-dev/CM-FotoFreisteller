<Window x:Class="CMFotoFreisteller.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bild-Warteschlange – CM FotoFreisteller"
        Width="980" Height="700" MinWidth="760" MinHeight="520"
        Background="#F4F6F8" WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Bild-Warteschlange" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Übersicht über Originale und Bearbeitungsstatus" Foreground="#667085" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E8F0FE" CornerRadius="10" Padding="11,6" VerticalAlignment="Center">
                <TextBlock x:Name="SummaryText" Text="0 Bilder" Foreground="#1D4ED8" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <ListView x:Name="QueueList" Grid.Row="2" Background="White" BorderThickness="0"
                  MouseDoubleClick="QueueList_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="6" Width="900">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="86" Height="68" Background="#FAFAFA" BorderBrush="#E4E7EC"
                                BorderThickness="1" CornerRadius="7">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Path}" Foreground="#667085" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,4,10,0"/>
                        </StackPanel>
                        <Border Grid.Column="3" Background="{Binding StatusBackground}"
                                CornerRadius="9" Padding="10,6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Doppelklick auf ein Bild öffnet die Vorher-/Nachher-Vorschau."
                       Foreground="#667085" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="Schließen" Click="Close_Click" Padding="16,8"/>
        </Grid>
    </Grid>
</Window>
