<Window x:Class="CMFotoFreisteller.ColorPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Farbe wählen" Width="560" Height="520" ResizeMode="NoResize"
 WindowStartupLocation="CenterOwner" Background="#F4F6F8">
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Hintergrundfarbe" FontSize="22" FontWeight="SemiBold"/>
  <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="12"/><RowDefinition Height="28"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="SvArea" MouseLeftButtonDown="SvArea_Mouse" MouseMove="SvArea_Mouse">
     <Rectangle x:Name="HueBase"/>
     <Rectangle>
      <Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
     </Rectangle>
     <Rectangle>
      <Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Rectangle.Fill>
     </Rectangle>
     <Ellipse x:Name="SvMarker" Width="16" Height="16" Stroke="White" StrokeThickness="2" Fill="Transparent" IsHitTestVisible="False"/>
    </Grid>
    <Grid Grid.Row="2" x:Name="HueArea" MouseLeftButtonDown="HueArea_Mouse" MouseMove="HueArea_Mouse">
     <Rectangle>
      <Rectangle.Fill>
       <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF0000" Offset="0"/><GradientStop Color="#FFFF00" Offset=".1667"/>
        <GradientStop Color="#00FF00" Offset=".3333"/><GradientStop Color="#00FFFF" Offset=".5"/>
        <GradientStop Color="#0000FF" Offset=".6667"/><GradientStop Color="#FF00FF" Offset=".8333"/>
        <GradientStop Color="#FF0000" Offset="1"/>
       </LinearGradientBrush>
      </Rectangle.Fill>
     </Rectangle>
     <Rectangle x:Name="HueMarker" Width="5" Stroke="White" StrokeThickness="2" Fill="#66000000" HorizontalAlignment="Left" IsHitTestVisible="False"/>
    </Grid>
    <Grid Grid.Row="4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="Preview" Width="58" Height="58" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="7"/>
     <StackPanel Grid.Column="1">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <TextBlock Text="HEX" VerticalAlignment="Center" FontWeight="SemiBold"/>
       <TextBox x:Name="HexBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center" TextChanged="HexBox_TextChanged"/>
       <TextBlock Grid.Column="3" x:Name="RgbText" VerticalAlignment="Center" Foreground="#667085"/>
      </Grid>
      <TextBlock Text="Farbe im Feld anklicken oder über HEX exakt eingeben." Foreground="#667085" FontSize="11" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </Grid>
  </Border>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Abbrechen" Click="Cancel_Click" Padding="14,8" Margin="4"/>
   <Button Content="Übernehmen" Click="Ok_Click" Padding="14,8" Margin="4" Background="#2563EB" Foreground="White"/>
  </StackPanel>
 </Grid>
</Window>