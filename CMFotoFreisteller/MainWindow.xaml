<Window x:Class="CMFotoFreisteller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CM FotoFreisteller" Height="760" Width="1180"
        MinHeight="650" MinWidth="980"
        Background="{StaticResource PageBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CM FotoFreisteller" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Gerätefotos automatisch freistellen und stapelweise verarbeiten"
                           Foreground="#667085" FontSize="14" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E8F0FE" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="V0.2.5 · Offline-Engine" Foreground="#1D4ED8" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Bilder" FontSize="18" FontWeight="SemiBold"/>
                    <Border Grid.Row="2" BorderBrush="#D0D5DD" BorderThickness="1.5"
                            CornerRadius="12" Background="#FAFBFC" AllowDrop="True"
                            Drop="DropArea_Drop" DragOver="DropArea_DragOver">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="＋" FontSize="42" HorizontalAlignment="Center" Foreground="#667085"/>
                            <TextBlock Text="Bilder oder Ordner hier ablegen" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="JPG · JPEG · PNG" Foreground="#667085" Margin="0,6,0,12"
                                       HorizontalAlignment="Center"/>
                            <Button Content="Bilder auswählen" Click="SelectFiles_Click"/>
                            <Button Content="Ordner auswählen" Click="SelectFolder_Click"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="4">
                        <TextBlock x:Name="SelectionText" Text="Noch keine Bilder ausgewählt."
                                   Foreground="#667085" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="14" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Verarbeitung" FontSize="18" FontWeight="SemiBold"/>
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Aktive Einstellungen" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ActiveSettingsText" Margin="0,5,0,0"
                                           Foreground="#667085" TextWrapping="Wrap"/>
                            </StackPanel>
                            
                        </Grid>
                    </Border>
                    <Border Grid.Row="4" Background="#F8FAFC" CornerRadius="12" Padding="16">
                        <StackPanel>
                            
                            <TextBlock Text="Bildstatus / Protokoll" FontWeight="SemiBold"/>
                            <TextBlock x:Name="QueueText" Margin="0,6,0,0" Foreground="#667085"
                                       Text="Noch keine Bilder geladen."/>
                            <TextBox x:Name="LogBox" Margin="0,8,0,0" Height="245"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Bereit" FontWeight="SemiBold"/>
                <ProgressBar x:Name="Progress" Height="7" Margin="0,7,24,0" Minimum="0" Maximum="100"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="⚙ Einstellungen" Click="Settings_Click"/>
                <Button Content="Bildliste" Click="Queue_Click"/>
                <Button Content="Vorschau" Click="Preview_Click"/>
                <Button Content="Ausgabe öffnen" Click="OpenOutput_Click"/>
                <Button Content="Alle bearbeiten" Click="Process_Click"
                        Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="6" Margin="4,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="#667085" FontSize="12">
                <Run Text="Entwickelt von "/><Run Text="C. Mihalik" FontWeight="SemiBold"/>
                <Run Text=" · CM FotoFreisteller V0.2.5"/>
            </TextBlock>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Entwickler / GitHub" Click="Developer_Click" Padding="11,6" FontSize="12"/>
                <Button Content="♥ Projekt unterstützen" Click="Support_Click" Padding="11,6" FontSize="12"/>
                <Button Content="Über" Click="About_Click" Padding="11,6" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
