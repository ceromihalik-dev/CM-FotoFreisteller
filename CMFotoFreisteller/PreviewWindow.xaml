<Window x:Class="CMFotoFreisteller.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vorschau – CM FotoFreisteller" Width="1180" Height="760"
        MinWidth="900" MinHeight="600" Background="#F4F6F8"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Vorher / Nachher" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="FileNameText" Foreground="#667085" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="CounterText" VerticalAlignment="Center"
                       Foreground="#667085" FontSize="14"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Original" FontWeight="SemiBold"/>
                    <Border Grid.Row="2" Background="#FAFAFA" CornerRadius="8">
                        <Image x:Name="OriginalImage" Stretch="Uniform" Margin="8"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Bearbeitet" FontWeight="SemiBold"/>
                    <Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Image x:Name="ProcessedImage" Stretch="Uniform" Margin="8"/>
                            <TextBlock x:Name="NoResultText" Text="Noch keine bearbeitete Datei vorhanden."
                                       Foreground="#98A2B3" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#667085"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="◀ Vorheriges" Click="Previous_Click" Padding="14,8" Margin="4"/>
                <Button Content="Nächstes ▶" Click="Next_Click" Padding="14,8" Margin="4"/>
                <Button Content="Schließen" Click="Close_Click" Padding="14,8" Margin="4"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
